# Copy this file to .env and fill in your key to enable grounded LLM answers.
# Without a key, the assistant still works — it falls back to returning the
# most relevant passages directly instead of failing.
ANTHROPIC_API_KEY=

# "tfidf" runs fully offline (default). "sentence-transformers" gives better
# semantic recall but downloads a model the first time it runs.
EMBEDDING_BACKEND=tfidf
