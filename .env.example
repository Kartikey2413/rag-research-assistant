# Ollama model used for grounded answers (pull it first: ollama pull llama3).
# If Ollama is unreachable the app falls back to returning the best passages.
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://localhost:11434

# tfidf (default, offline) or sentence-transformers (better recall, ~1 GB RAM)
EMBEDDING_BACKEND=tfidf

# Host port for docker compose (80 on EC2)
HOST_PORT=8000
